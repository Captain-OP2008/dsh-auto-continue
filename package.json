{
  "name": "dsh-auto-continue",
  "version": "0.1.0",
  "private": true,
  "description": "Auto-continue a DSH session whose turn ended abnormally: output token limit reached, turn failed, or turn interrupted",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "auto-continue"
  ],
  "scripts": {
    "test": "node tests/state-machine.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
